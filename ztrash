# --- Argument parsing ------------------------------------------------------

typeset -a TARGETS
TARGETS=()
typeset -g OP=""
typeset -g OP_ARG=""
typeset -i HAVE_OP=0

set_op() { OP=$1; OP_ARG=$2; HAVE_OP=1 }

parse_args() {
    local -a args
    args=("$@")
    local -i n=$#args i=1
    local -i no_more_opts=0
    local a
    # Modifier flags are accepted anywhere, including after a subcommand:
    # `ztrash restore '*.log' -y` is what people actually type.
    local -a rest
    local -i j

    while (( i <= n )); do
        a=${args[i]}
        if (( no_more_opts )); then
            TARGETS+=("$a")
            (( i++ ))
            continue
        fi
        case $a in
            --)                    no_more_opts=1 ;;
            -y|--yes)              ASSUME_YES=1 ;;
            -n|--dry-run)          DRY_RUN=1 ;;
            -v|--verbose)          VERBOSE=1 ;;
            --json)                USE_JSON=1 ;;
            -l|--list)             set_op list "" ;;
            -r|--restore)          set_op restore "" ;;
            -d|--delete)           set_op delete "" ;;
            -e|--empty)            set_op empty "" ;;
            -s|--size)             set_op size "" ;;
            -u|--undo)             set_op undo "" ;;
            -w|--watch)            set_op watch "" ;;
            --fzf)                 set_op fzf "" ;;
            --gc)                  set_op gc "" ;;
            -p|--purge)
                (( i++ ))
                if (( i > n )) || [[ ${args[i]} == -* ]]; then
                    # A bare --purge, or one followed by another flag, means
                    # "use the configured age".
                    set_op purge "$PURGE_DAYS"
                elif [[ ${args[i]} == <-> ]]; then
                    set_op purge "${args[i]}"
                else
                    die_usage "option '$a' requires a number of days."
                fi
                ;;
            -h|--help)             show_help; exit $EXIT_OK ;;
            --version)             print -r -- "ztrash version $VERSION"; exit $EXIT_OK ;;
            --print-completion)
                (( i++ ))
                (( i > n )) && die_usage "option '--print-completion' requires a shell name."
                set_op completion "${args[i]}"
                ;;
            -*)                    die_usage "unknown option: $a." ;;
            find|restore)
                # A subcommand owns the rest of the command line, except for
                # the modifier flags, which are still honoured wherever they
                # appear.
                rest=()
                for (( j = i + 1; j <= n; j++ )); do
                    case ${args[j]} in
                        -y|--yes)          ASSUME_YES=1 ;;
                        -n|--dry-run)      DRY_RUN=1 ;;
                        -v|--verbose)      VERBOSE=1 ;;
                        *)                 rest+=("${args[j]}") ;;
                    esac
                done
                set_op "sub:$a" "${rest[@]}"
                break
                ;;
            *)                     TARGETS+=("$a") ;;
        esac
        (( i++ ))
    done
}

trash_targets() {
    local -i rc=0
    local t
    for t in $TARGETS; do
        if [[ ! -e $t && ! -L $t ]]; then
            warn "'$t' does not exist."
            rc=$EXIT_FAIL
            continue
        fi
        trash_one "$t" || rc=$EXIT_FAIL
    done
    return $rc
}

dispatch() {
    local -i rc=0
    if (( HAVE_OP )); then
        case $OP in
            list)             list_trash ;;
            size)             show_size ;;
            restore)          interactive_action restore ;;
            delete)           interactive_action delete ;;
            empty)            empty_trash ;;
            undo)             undo_trash ;;
            watch)            watch_trash ;;
            purge)            purge_trash "$OP_ARG" ;;
            fzf)              fzf_action ;;
            gc)               gc_trash ;;
            completion)       print_completion "$OP_ARG" || exit $EXIT_USAGE ;;
            sub:find)         find_trash "$OP_ARG" ;;
            sub:restore)      restore_pattern "$OP_ARG" ;;
            *)                die_usage "unknown operation: $OP." ;;
        esac
        rc=$?
        exit $rc
    fi
    if (( ${#TARGETS} == 0 )); then
        show_help
        exit $EXIT_OK
    fi
    trash_targets
    exit $?
}

main() {
    init_colors
    init_now
    detect_du_batch
    mkdir -p -- "$TRASH_ROOT/files" "$TRASH_ROOT/info" 2>/dev/null
    parse_args "$@"
    dispatch
}

main "$@"
