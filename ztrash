VERSION="1.1.0"

# --- Options ---
setopt EXTENDED_GLOB NO_UNSET NO_ALIASES
emulate -L zsh

# Exit codes: 0 success, 1 an operation failed, 2 usage error.
readonly EXIT_OK=0 EXIT_FAIL=1 EXIT_USAGE=2

# --- Configuration ---
# Load ~/.config/ztrash/config if present, then apply environment overrides.
typeset -g ZTRASH_CONFIG_DIR="${ZDG_CONFIG_HOME:-$HOME/.config}/ztrash"
[[ -r $ZTRASH_CONFIG_DIR/config ]] && source $ZTRASH_CONFIG_DIR/config

typeset -g ASSUME_YES=0
typeset -g DRY_RUN=0
typeset -g VERBOSE=0
typeset -g USE_JSON=0
typeset -g WATCH_INTERVAL="${ZTRASH_INTERVAL:-2}"
# Default age for --purge when the user does not pass one. ZTRASH_PURGE_DAYS is
# honoured so the config file can set it once instead of editing a muscle
# memory.
typeset -g PURGE_DAYS="${ZTRASH_PURGE_DAYS:-30}"

typeset -g TRASH_ROOT="${ZTRASH_TRASH_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/Trash}"

# --- Colours ---
typeset -g BOLD="" DIM="" RED="" GREEN="" YELLOW="" BLUE="" MAGENTA="" CYAN="" RESET=""
init_colors() {
    # NO_COLOR wins, then an explicit force flag, then tty autodetection.
    if [[ -n ${NO_COLOR-} || -n ${ZTRASH_NO_COLOR-} ]]; then
        return
    elif [[ -n ${ZTRASH_FORCE_COLOR-} || -t 1 ]]; then
        BOLD=$'\e[1m' DIM=$'\e[2m' RED=$'\e[31m' GREEN=$'\e[32m'
        YELLOW=$'\e[33m' BLUE=$'\e[34m' MAGENTA=$'\e[35m' CYAN=$'\e[36m' RESET=$'\e[0m'
    fi
}

# --- Output helpers ---
warn() { print -r -- "${RED}Error:${RESET} $*" >&2 }
note() { print -r -- "  ${YELLOW}!${RESET} $*" }
ok()   { print -r -- "  ${GREEN}✓${RESET} $*" }

die_usage() {
    warn "$*"
    print -r -- "Try '${DIM}ztrash --help${RESET}' for more information." >&2
    exit $EXIT_USAGE
}

confirm() {
    # $1 = prompt text, $2 = y|N. Returns 0 on consent.
    (( ASSUME_YES )) && return 0
    if [[ ! -t 0 && ! -p /dev/stdin ]]; then
        warn "refusing to prompt without a terminal; re-run with -y."
        return 1
    fi
    local reply=""
    print -rn -- "$1 "
    # read returns non-zero when the input ends without a newline, which is not
    # a reason to throw away what the user typed.
    read -r reply
    [[ $reply == [yY] ]]
}

# --- Terminal geometry ---
term_width() {
    # zsh sets COLUMNS=0 when stdout is not a tty, so ${COLUMNS:-80} is not
    # enough -- 0 has to be treated as "unknown" and probed, then floored so
    # the path column can never collapse to nothing.
    local -i w=${ZTRASH_COLS:-${COLUMNS:-0}}
    (( w > 0 )) || w=$(command tput cols 2>/dev/null) || w=80
    (( w < 40 )) && w=40
    print -r -- $w
}

truncate_path() {
    local p=$1
    local -i max=$2
    (( max < 12 )) && max=12
    if (( ${#p} <= max )); then
        REPLY=$p
    elif (( max < 8 )); then
        REPLY=${p:0:$max}
    else
        local -i head=$(( (max - 1) / 2 ))
        local -i tail=$(( max - 1 - head ))
        REPLY="${p[1,$head]}…${p[-$tail,-1]}"
    fi
}

# A horizontal rule sized to the terminal.
hr() {
    local -i n=${1:-60}
    (( n < 1 )) && n=1
    local pad
    printf -v pad '%*s' $n ''
    print -r -- "  ${DIM}${pad// /─}${RESET}"
}

# Human-readable size. The result is left in $REPLY rather than printed:
# callers that want a string need it several hundred times per listing and a
# $(...) around every one of those is a fork per item.
format_bytes() {
    local -i bytes=${1:-0}
    if (( bytes < 1024 )); then
        printf -v REPLY '%dB' $bytes
    elif (( bytes < 1048576 )); then
        printf -v REPLY '%.1fK' "$(( bytes / 1024.0 ))"
    elif (( bytes < 1073741824 )); then
        printf -v REPLY '%.1fM' "$(( bytes / 1048576.0 ))"
    elif (( bytes < 1099511627776 )); then
        printf -v REPLY '%.1fG' "$(( bytes / 1073741824.0 ))"
    else
        printf -v REPLY '%.1fT' "$(( bytes / 1099511627776.0 ))"
    fi
}

# Human date for the current time, used to decide how to render each item.
typeset -g NOW_STAMP=""
init_now() { [[ -n $NOW_STAMP ]] || NOW_STAMP=$(date +%Y-%m-%dT%H:%M:%S) }

format_date() {
    local stamp=$1
    [[ -z $stamp ]] && { REPLY='Unknown'; return }
    init_now
    # Subscripting a zsh scalar is a character *range*, not a start plus count,
    # so these are inclusive end offsets: 1-10 date, 6-10 month/day, 12-16 time.
    if [[ ${stamp[1,10]} == ${NOW_STAMP[1,10]} ]]; then
        REPLY=${stamp[12,16]}
    elif [[ ${stamp[1,4]} == ${NOW_STAMP[1,4]} ]]; then
        REPLY="${stamp[6,10]} ${stamp[12,16]}"
    else
        REPLY=${stamp[1,10]}
    fi
}

# --- URL encoding (RFC 2396 / FreeDesktop Path= format) ---
# Byte-wise so multi-byte filenames survive intact. No python3, no forks.
url_encode() {
    emulate -L zsh
    setopt LOCAL_OPTIONS EXTENDED_GLOB
    local LC_ALL=C
    local str=$1
    # Fast path: the overwhelmingly common case is a path that needs no
    # encoding at all, and the byte loop below costs about a millisecond each.
    if [[ $str != *[^A-Za-z0-9/._~-]* ]]; then
        print -rn -- $str
        return 0
    fi
    local -a octets
    octets=(${(s::)str})
    local out="" c
    for c in $octets; do
        case "$c" in
            [a-zA-Z0-9/._~-]) out+="$c" ;;
            *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
        esac
    done
    print -rn -- "$out"
}

url_decode() {
    emulate -L zsh
    setopt LOCAL_OPTIONS EXTENDED_GLOB
    local LC_ALL=C
    local str=$1
    # Fast path: with no escape sequence in the string the byte loop below
    # cannot change anything, and it costs about a millisecond per path.
    if [[ $str != *%* ]]; then
        print -rn -- $str
        return 0
    fi
    local out="" c
    local -i i
    for (( i = 1; i <= ${#str}; i++ )); do
        c=$str[i]
        if [[ $c == '%' && $str[i+1,i+2] == [0-9a-fA-F][0-9a-fA-F] ]]; then
            printf -v c "\x$str[i+1,i+2]"
            out+=$c
            (( i += 2 ))
        else
            out+=$c
        fi
    done
    print -rn -- "$out"
}

# --- Bin discovery -------------------------------------------------------
# The FreeDesktop spec allows a per-filesystem trash at <topdir>/.Trash-$uid or
# <topdir>/.Trash/$uid. Using it matters: it keeps trashing a file on another
# mount a cheap rename instead of a full cross-device copy, and it keeps
# restores anchored to the right mount after a remount.

file_device() { stat -c '%d' -- "$1" 2>/dev/null }

mount_point_of() {
    local mp
    mp=$(stat -c '%m' -- "$1" 2>/dev/null)
    if [[ -n $mp && $mp != / ]]; then
        print -r -- "$mp"
        return 0
    fi
    # Fallback: longest prefix match against /proc/mounts.
    local -a entries
    local line best="" mnt
    local -i bestlen=0
    while IFS= read -r line; do
        mnt=${line#* }
        mnt=${mnt%% *}
        [[ $mnt == / ]] && continue
        if [[ $1 == $mnt(|/*) ]]; then
            if (( ${#mnt} > bestlen )); then
                bestlen=${#mnt}
                best=$mnt
            fi
        fi
    done < /proc/mounts 2>/dev/null
    print -r -- "${best:-/}"
}

# Decide which bin $1 belongs in. Sets ZTRASH_BIN, ZTRASH_BIN_TOPDIR (empty
# for the home bin) and ZTRASH_BIN_RELATIVE (1 when Path= must be stored
# relative to the topdir).
resolve_bin() {
    local target=$1
    ZTRASH_BIN=$TRASH_ROOT
    ZTRASH_BIN_TOPDIR=""
    ZTRASH_BIN_RELATIVE=0
    ZTRASH_BIN_FALLBACK=0

    local -i dev_target dev_home
    dev_target=$(file_device "$target") || return 0
    dev_home=$(file_device "$TRASH_ROOT") || dev_home=$dev_target

    (( dev_target == dev_home )) && return 0

    local topdir
    topdir=$(mount_point_of "$target")
    [[ -z $topdir || $topdir == / ]] && return 0

    local -i uid=${EUID:-$(id -u)}
    local cand=$topdir/.Trash-$uid
    if [[ -d $cand ]] || [[ -w $topdir ]]; then
        if mkdir -p -- "$cand/files" "$cand/info" 2>/dev/null; then
            ZTRASH_BIN=$cand
            ZTRASH_BIN_TOPDIR=$topdir
            ZTRASH_BIN_RELATIVE=1
            return 0
        fi
    fi

    cand=$topdir/.Trash/$uid
    if [[ -d $topdir/.Trash ]] && [[ -k $topdir/.Trash ]] && [[ -w $topdir/.Trash ]]; then
        if mkdir -p -- "$cand/files" "$cand/info" 2>/dev/null; then
            ZTRASH_BIN=$cand
            ZTRASH_BIN_TOPDIR=$topdir
            ZTRASH_BIN_RELATIVE=1
            return 0
        fi
    fi

    # Not writable: fall back to the home bin, but say so.
    ZTRASH_BIN_FALLBACK=1
    return 0
}

# --- Item model ---
# The trash is walked once into parallel arrays. A pipe-delimited record
# format was tried and is not safe: '|' is a legal filename byte.
typeset -ga IT_BASE IT_BIN IT_PATH IT_DATE IT_SIZE IT_GOOD

load_items() {
    IT_BASE=() IT_BIN=() IT_PATH=() IT_DATE=() IT_SIZE=() IT_GOOD=()
    local -a infos
    infos=("$TRASH_ROOT/info"/*.trashinfo(N))
    (( ${#infos} )) || return 0

    local f line
    local topdir=${TRASH_ROOT:h}
    for f in $infos; do
        local base=${f:t:r}
        # `path` is a special zsh parameter tied to $PATH -- never use it here.
        local encpath="" stamp=""
        while IFS= read -r line; do
            case $line in
                Path=*)         encpath=${line#Path=} ;;
                DeletionDate=*) stamp=${line#DeletionDate=} ;;
            esac
        done < $f
        [[ -z $encpath ]] && continue
        local decoded=""
        decoded=$(url_decode "$encpath")
        [[ -z $decoded ]] && continue
        # A relative Path= is the spec's form for a topdir trash and is only
        # meaningful relative to the directory holding the bin.
        [[ $decoded != /* ]] && decoded=$topdir/$decoded
        IT_BASE+=("$base")
        IT_BIN+=("$TRASH_ROOT")
        IT_PATH+=("$decoded")
        IT_DATE+=("$stamp")
        IT_SIZE+=(0)
        IT_GOOD+=("$([[ -e $TRASH_ROOT/files/$base || -L $TRASH_ROOT/files/$base ]] && print 1 || print 0)")
    done

    size_items
    sort_items_by_date_desc
}

# One du for the whole trash instead of one per item.
typeset -g DU_BATCH=0
detect_du_batch() {
    du --help 2>&1 | grep -q -- '--files0-from' && DU_BATCH=1
}

size_items() {
    (( ${#IT_BASE} )) || return 0
    local -i i
    local -a existing
    existing=()
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        local p=$IT_BIN[i]/files/$IT_BASE[i]
        if [[ -e $p || -L $p ]]; then
            existing+=($p)
        else
            IT_SIZE[i]=0
        fi
    done
    (( ${#existing} )) || return 0

    if (( DU_BATCH )); then
        local -A sizes
        local listfile
        listfile=$(mktemp "${TMPDIR:-/tmp}/ztrash.du.XXXXXX") || return 0
        # `p` stays local from the loop above. Re-declaring a local inside a
        # loop makes zsh echo its old value, which corrupts the output.
        for p in $existing; do print -N -- $p >> $listfile; done
        # Split into a local first: zsh does not apply the ## / %% operators
        # to an expansion written inside a subscript, so doing it inline
        # silently stores the whole line as the key and every lookup misses.
        local line sz key
        while IFS= read -r line; do
            [[ -z $line ]] && continue
            sz=${line%%$'\t'*}
            key=${line#*$'\t'}
            sizes[$key]=$sz
        done < <(du -sb --files0-from=$listfile 2>/dev/null)
        rm -f -- $listfile
        for (( i = 1; i <= ${#IT_BASE}; i++ )); do
            p=$IT_BIN[i]/files/$IT_BASE[i]
            if [[ -n ${sizes[$p]-} ]]; then
                IT_SIZE[i]=${sizes[$p]}
            fi
        done
    else
        for (( i = 1; i <= ${#IT_BASE}; i++ )); do
            p=$IT_BIN[i]/files/$IT_BASE[i]
            [[ -e $p || -L $p ]] || continue
            IT_SIZE[i]=$(du -sb -- $p 2>/dev/null) || IT_SIZE[i]=0
            IT_SIZE[i]=${IT_SIZE[i]%%$'\t'*}
        done
    fi
}

sort_items_by_date_desc() {
    local -i i
    typeset -i n=${#IT_BASE}
    (( n < 2 )) && return 0
    # Newest first. The permutation is worked out on "date<TAB>index" records
    # sorted by zsh itself: a hand-written insertion sort is O(n^2) and becomes
    # a visible stall once a trash holds a few hundred items. The zero-padded
    # index keeps items trashed in the same second in their original order, and
    # the arrays are permuted once at the end instead of on every comparison.
    local -a recs
    recs=()
    local -i pad
    for (( i = 1; i <= n; i++ )); do
        # printf -v rather than $(printf ...): a command substitution here is a
        # fork per item, which is most of the cost of listing a large trash.
        printf -v pad '%08d' $i
        recs+=("$IT_DATE[i]"$'\t'"$pad")
    done
    recs=(${(o)recs})
    # Descending: zsh has no combined sort-and-reverse flag, and an explicit
    # `$recs[n,1]` range is empty rather than reversed, so walk the sorted
    # records backwards. That also puts the most recently binned item first
    # when several share a timestamp, which is what -u and the picker want.
    local -a new_date new_base new_bin new_path new_size new_good
    new_date=(); new_base=(); new_bin=(); new_path=(); new_size=(); new_good=()
    local rec idx
    for (( i = n; i >= 1; i-- )); do
        rec=${recs[i]}
        idx=$(( 10#${rec##*$'\t'} ))
        new_date+=("$IT_DATE[idx]")
        new_base+=("$IT_BASE[idx]")
        new_bin+=("$IT_BIN[idx]")
        new_path+=("$IT_PATH[idx]")
        new_size+=("$IT_SIZE[idx]")
        new_good+=("$IT_GOOD[idx]")
    done
    IT_DATE=("${new_date[@]}")
    IT_BASE=("${new_base[@]}")
    IT_BIN=("${new_bin[@]}")
    IT_PATH=("${new_path[@]}")
    IT_SIZE=("${new_size[@]}")
    IT_GOOD=("${new_good[@]}")
}

total_bytes() {
    local -i t=0 i
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do (( t += IT_SIZE[i] )); done
    print -r -- $t
}

# --- Core operations -------------------------------------------------------

# Move $1 into a bin, honouring the spec's per-filesystem layout.
trash_one() {
    local target=$1
    local abs
    # -s keeps symlinks unexpanded; a trashed link must stay the link.
    abs=$(realpath -s -- "$target") || abs=$target

    if [[ $abs == ${TRASH_ROOT}* ]]; then
        warn "'$target' is already inside the trash; refusing."
        return 1
    fi

    resolve_bin "$abs"
    local -i rel=$ZTRASH_BIN_RELATIVE
    local topdir=$ZTRASH_BIN_TOPDIR
    local bin=$ZTRASH_BIN

    if (( rel )); then
        abs=${abs#$topdir/}
    fi
    if (( ZTRASH_BIN_FALLBACK )); then
        note "'$target' is on another filesystem that is not writable; using the home trash."
    fi

    local base=${abs:t}
    local -i tries=0
    local unique
    while :; do
        unique="${base}_${$}_${RANDOM}"
        (( tries++ ))
        [[ -e $bin/files/$unique || -e $bin/info/$unique.trashinfo ]] || break
        (( tries < 100 )) || { warn "could not find a free name for '$target'"; return 1; }
    done

    if (( DRY_RUN )); then
        ok "would bin '$base'"
        return 0
    fi

    # Prefer a rename; fall back to copy+unlink across filesystems.
    if ! mv -n -- "$target" "$bin/files/$unique" 2>/dev/null; then
        if ! cp -a -- "$target" "$bin/files/$unique" 2>/dev/null; then
            rm -rf -- "$bin/files/$unique"
            warn "failed to move '$target' to the trash."
            return 1
        fi
        rm -rf -- "$target"
    fi

    mkdir -p -- "$bin/info" || return 1
    {
        print -r -- "[Trash Info]"
        print -r -- "Path=$(url_encode "$abs")"
        print -r -- "DeletionDate=$(date +%Y-%m-%dT%H:%M:%S)"
    } > "$bin/info/$unique.trashinfo" || {
        rm -rf -- "$bin/files/$unique"
        warn "failed to write trash metadata for '$target'."
        return 1
    }

    (( VERBOSE )) && ok "binned '${CYAN}${base}${RESET}'${DIM} (${bin})${RESET}"
    return 0
}

# Restore one item. $1 = index into the IT_* arrays.
restore_one() {
    local -i idx=$1
    local base=$IT_BASE[idx] bin=$IT_BIN[idx] orig=$IT_PATH[idx]
    local payload=$bin/files/$base

    if [[ ! -e $payload && ! -L $payload ]]; then
        warn "payload for '${orig:t}' is missing; skipping."
        return 1
    fi

    if [[ -e $orig || -L $orig ]]; then
        local tw; truncate_path "$orig" $(( $(term_width) - 40 )); tw=$REPLY
        if ! confirm "${YELLOW}'$tw' already exists. Overwrite? [${YELLOW}y${RESET}/${DIM}N${RESET}]"; then
            note "skipped '${orig:t}'."
            return 1
        fi
    fi

    if (( DRY_RUN )); then
        ok "would restore '${orig:t}'"
        return 0
    fi

    local backup=""
    if [[ -e $orig || -L $orig ]]; then
        # Stage the existing target aside so a failed restore can roll back
        # and so a directory never gets nested inside another one.
        backup="$orig.ztrash-replaced.$$"
        rm -rf -- "$backup" 2>/dev/null
        if ! mv -T -- "$orig" "$backup" 2>/dev/null; then
            warn "could not replace '$orig'."
            return 1
        fi
    fi

    mkdir -p -- "${orig:h}" 2>/dev/null
    if ! mv -T -- "$payload" "$orig" 2>/dev/null; then
        [[ -n $backup ]] && mv -T -- "$backup" "$orig" 2>/dev/null
        warn "failed to restore '$orig'."
        return 1
    fi

    rm -f -- "$bin/info/$base.trashinfo"
    [[ -n $backup ]] && rm -rf -- "$backup"
    format_bytes $IT_SIZE[idx]
    ok "restored '${GREEN}${orig:t}${RESET}' (${YELLOW}$REPLY${RESET})"
    return 0
}

# Permanently remove one item. $1 = index into the IT_* arrays.
delete_one() {
    local -i idx=$1
    local base=$IT_BASE[idx] bin=$IT_BIN[idx] orig=$IT_PATH[idx]

    if (( DRY_RUN )); then
        format_bytes $IT_SIZE[idx]
        ok "would delete '${orig:t}' (${YELLOW}$REPLY${RESET})"
        return 0
    fi

    rm -rf -- "$bin/files/$base" || { warn "could not delete '$orig'."; return 1 }
    rm -f -- "$bin/info/$base.trashinfo"
    ok "deleted '${RED}${orig:t}${RESET}'"
    return 0
}

# --- JSON ------------------------------------------------------------------

json_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    s=${s//$'\e'/\\e}
    REPLY=$s
}

emit_json() {
    local -i i
    local -i total
    total=$(total_bytes)
    # NB: never a local named `path`; it is tied to $PATH in zsh.
    local name orig size date bin present
    json_escape "$TRASH_ROOT"; local trash=$REPLY
    print -r -- "{"
    print -r -- "  \"version\": \"$VERSION\","
    print -r -- "  \"trash\": \"$trash\","
    print -r -- "  \"count\": ${#IT_BASE},"
    print -r -- "  \"total_bytes\": $total,"
    print -r -- "  \"items\": ["
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        local sep=","
        (( i == ${#IT_BASE} )) && sep=""
        json_escape "${IT_PATH[i]:t}"; name=$REPLY
        json_escape "$IT_PATH[i]"; orig=$REPLY
        format_bytes $IT_SIZE[i]; size=$REPLY
        json_escape "$IT_DATE[i]"; date=$REPLY
        json_escape "$IT_BIN[i]"; bin=$REPLY
        present=false; [[ $IT_GOOD[i] == 1 ]] && present=true
        print -r -- "    {"
        print -r -- "      \"name\": \"$name\","
        print -r -- "      \"path\": \"$orig\","
        print -r -- "      \"size_bytes\": $IT_SIZE[i],"
        print -r -- "      \"size\": \"$size\","
        print -r -- "      \"deletion_date\": \"$date\","
        print -r -- "      \"present\": $present,"
        print -r -- "      \"bin\": \"$bin\""
        print -r -- "    }$sep"
    done
    print -r -- "  ]"
    print -r -- "}"
}

# --- Actions ---------------------------------------------------------------

list_trash() {
    load_items
    if (( USE_JSON )); then
        emit_json
        return 0
    fi
    if (( ! ${#IT_BASE} )); then
        print -r -- "${GREEN}Trash is empty.${RESET}"
        return 0
    fi

    local -i total
    total=$(total_bytes)
    local -i w
    w=$(term_width)
    local -i pathcol=$(( w - 26 ))
    # Below this a truncated path is useless, so stack the path on its own line
    # instead of mangling it.
    local -i stacked=0
    if (( pathcol < 34 )); then
        stacked=1
    else
        (( pathcol > w - 4 )) && pathcol=$(( w - 4 ))
    fi
    local -i wl=$(( w - 2 ))
    local rule
    rule=$(hr $wl)

    local -i i
    local -i missing=0
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        (( IT_GOOD[i] )) || (( missing++ ))
    done

    format_bytes $total
    print -r -- "  ${BOLD}${CYAN}Trash${RESET} ${DIM}(${YELLOW}${#IT_BASE}${RESET}${DIM} item(s), ${YELLOW}$REPLY${RESET}${DIM})${RESET}"
    (( missing )) && print -r -- "  ${DIM}${missing} of those have no payload on disk${RESET}"
    print -r -- $rule
    if (( stacked )); then
        print -r -- "  ${CYAN}$(printf '%-17s' 'Binned')  ${YELLOW}$(printf '%5s' 'Size')${RESET}"
    else
        print -r -- "  ${CYAN}$(printf '%-17s' 'Binned')  ${YELLOW}$(printf '%5s' 'Size')  ${BLUE}Path${RESET}"
    fi
    print -r -- $rule

    # NB: never use `path` as a local name; it is tied to $PATH in zsh.
    local stamp sz full shown
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        format_date "$IT_DATE[i]"; stamp=$REPLY
        format_bytes $IT_SIZE[i]; sz=$REPLY
        truncate_path "$IT_PATH[i]" $pathcol; shown=$REPLY
        full=$IT_PATH[i]
        [[ $IT_GOOD[i] != 1 ]] && full="${RED}${full}${RESET} ${DIM}(missing)${RESET}"
        if (( i % 2 == 0 )); then
            if (( stacked )); then
                printf "  ${DIM}${CYAN}%-17s  ${YELLOW}%5s${RESET}\n        %s\n" "$stamp" "$sz" "$full"
            else
                printf "  ${DIM}${CYAN}%-17s  ${YELLOW}%5s  %s${RESET}\n" "$stamp" "$sz" "$shown"
            fi
        else
            if (( stacked )); then
                printf "  ${CYAN}%-17s  ${YELLOW}%5s\n        %s\n" "$stamp" "$sz" "$full"
            else
                printf "  ${CYAN}%-17s  ${YELLOW}%5s  %s\n" "$stamp" "$sz" "$shown"
            fi
        fi
    done

    format_bytes $total
    print -r -- $rule
    if (( stacked )); then
        printf "  %-17s  ${BOLD}${YELLOW}%5s${RESET}\n" "" "$REPLY"
    else
        printf "  %-17s  ${BOLD}${YELLOW}%5s  ${BOLD}${BLUE}%s${RESET}\n" "" "$REPLY" "Total"
    fi
}

show_size() {
    load_items
    if (( USE_JSON )); then
        emit_json
        return 0
    fi
    local -i total
    total=$(total_bytes)
    format_bytes $total
    print -r -- "Trash size: ${BOLD}${YELLOW}$REPLY${RESET} ${DIM}(${CYAN}${#IT_BASE}${RESET}${DIM} item(s))${RESET}"
}

# Purge entries older than $1 days. Compares ISO strings: the format is
# fixed-width and lexicographically ordered, so no date(1) call is needed.
purge_trash() {
    local -i days=$1
    # The comparison is inclusive, so `--purge 0` means "purge everything that is
    # in the trash right now" instead of "purge things deleted in an earlier
    # second". Dry runs use the same cutoff so both report identically.
    local -i now_epoch cutoff_epoch
    now_epoch=$(date +%s 2>/dev/null) || { warn "cannot compute a cutoff date."; return 1; }
    cutoff_epoch=$(( now_epoch - days * 86400 ))
    local cutoff
    cutoff=$(date -d "@$cutoff_epoch" +%Y-%m-%dT%H:%M:%S 2>/dev/null) || cutoff=$NOW_STAMP
    [[ -z $cutoff ]] && { warn "cannot compute a cutoff date."; return 1; }

    load_items
    local -i i purged=0
    local -i freed=0
    local -a victims=()
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        local d=$IT_DATE[i]
        [[ -z $d ]] && continue
        # zsh's [[ ]] has no <= operator, so spell it out.
        if [[ $d < $cutoff || $d == $cutoff ]]; then
            victims+=($i)
            (( freed += IT_SIZE[i] ))
            (( purged++ ))
        fi
    done

    if (( DRY_RUN )); then
        format_bytes $freed
        print -r -- "  ${CYAN}Would purge${RESET} ${BOLD}$purged${RESET} item(s) (${YELLOW}$REPLY${RESET}) older than ${MAGENTA}$days${RESET} day(s)."
        (( purged )) || return 0
        for i in $victims; do
            print -r -- "    ${DIM}${IT_PATH[i]}${RESET}"
        done
        return 0
    fi

    for i in $victims; do
        delete_one $i
    done
    format_bytes $freed
    print -r -- "  ${CYAN}Purged${RESET} ${BOLD}$purged${RESET} item(s) (${YELLOW}$REPLY${RESET}) older than ${MAGENTA}$days${RESET} day(s)."
}

empty_trash() {
    load_items
    if (( ! ${#IT_BASE} )); then
        print -r -- "${GREEN}Trash is already empty.${RESET}"
        return 0
    fi
    local -i total
    total=$(total_bytes)
    format_bytes $total
    if ! confirm "${RED}${BOLD}Really empty the trash?${RESET} ${YELLOW}${#IT_BASE}${RESET} item(s), ${BOLD}${YELLOW}$REPLY${RESET}. [${RED}y${RESET}/${DIM}N${RESET}]"; then
        print -r -- "${YELLOW}Aborted.${RESET} Trash not emptied."
        return 0
    fi
    if (( DRY_RUN )); then
        local -i i
        for (( i = 1; i <= ${#IT_BASE}; i++ )); do
            ok "would delete '${IT_PATH[i]:t}'"
        done
        print -r -- "  ${CYAN}Would have emptied${RESET} ${BOLD}${#IT_BASE}${RESET} item(s)."
        return 0
    fi
    local -i i
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        rm -rf -- "$TRASH_ROOT/files/$IT_BASE[i]"
        rm -f -- "$TRASH_ROOT/info/$IT_BASE[i].trashinfo"
    done
    format_bytes $total
    print -r -- "  ${GREEN}${BOLD}Trash emptied.${RESET} ${YELLOW}$REPLY${RESET} freed."
    return 0
}

undo_trash() {
    load_items
    if (( ! ${#IT_BASE} )); then
        print -r -- "${YELLOW}Nothing to undo.${RESET} The bin is empty."
        return 0
    fi
    restore_one 1
}

# Shared numbered menu for restore and delete.
interactive_action() {
    local action=$1
    local -a cands
    cands=()
    load_items
    local -i i
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        cands+=($i)
    done
    if (( ! ${#cands} )); then
        print -r -- "${YELLOW}Nothing to $action.${RESET} The bin is empty."
        return 0
    fi

    local -i w
    w=$(term_width)
    local -i wl=$(( w - 2 ))
    local rule
    rule=$(hr $wl)

    local verb="restore"
    [[ $action == delete ]] && verb="permanently delete"
    print -r -- "  ${BOLD}${CYAN}Select items to $verb${RESET}"
    print -r -- $rule
    printf "  ${DIM}%3s  %5s  %-20s  %s${RESET}\n" "#" "Size" "Name" "Original Path"
    print -r -- $rule

    local -i shown=0 total=0
    for i in $cands; do
        local -i num=$(( ++shown ))
        # The original path is the whole point of the picker, so it is never
        # truncated; a long path simply soft-wraps.
        local disp=$IT_PATH[i]
        [[ $IT_GOOD[i] != 1 ]] && disp="${RED}${disp}${RESET} ${DIM}(missing)${RESET}"
        format_bytes $IT_SIZE[i]
        printf "  ${CYAN}%2d)${RESET}  ${YELLOW}%5s${RESET}  ${BOLD}%-20s${RESET}  ${DIM}%s${RESET}\n" \
            "$num" "$REPLY" "${IT_PATH[i]:t}" "$disp"
        (( total += IT_SIZE[i] ))
    done

    print -r -- $rule
    format_bytes $total
    print -r -- "  ${CYAN}$shown${RESET}${DIM} item(s), ${YELLOW}$REPLY${RESET}${RESET}"
    print -r -- ""

    print -rn -- "${BOLD}${CYAN}Numbers to $verb${RESET} ${DIM}(e.g. 1 2 5, 1-5, all)${RESET} or '${RED}q${RESET}': "
    local response=""
    read -r response
    [[ -z $response || $response == q ]] && return 0

    response="${response//,/ }"
    local -a choices
    choices=()
    local token
    local -i n
    for token in ${=response}; do
        if [[ $token == all ]]; then
            choices=()
            for (( n = 1; n <= shown; n++ )); do choices+=($n); done
            break
        elif [[ $token == <->-<-> ]]; then
            for (( n = ${token%%-*}; n <= ${token##*-}; n++ )); do choices+=($n); done
        elif [[ $token == <-> ]]; then
            choices+=($token)
        fi
    done

    local -i rc=0
    local idx
    for n in $choices; do
        if (( n < 1 || n > shown )); then
            note "Invalid choice: $n"
            rc=1
            continue
        fi
        idx=$cands[n]
        if [[ $action == restore ]]; then
            restore_one $idx || rc=1
        else
            delete_one $idx || rc=1
        fi
    done
    return $rc
}

fzf_action() {
    if ! command -v fzf >/dev/null 2>&1; then
        warn "fzf is not installed. Install it with your package manager."
        return 1
    fi
    if [[ ! -t 0 && ! -p /dev/stdin ]]; then
        warn "--fzf needs an interactive terminal."
        return $EXIT_USAGE
    fi
    load_items
    if (( ! ${#IT_BASE} )); then
        print -r -- "${GREEN}The bin is empty.${RESET}"
        return 0
    fi

    local -a input
    input=()
    local -i i
    local stamp sz
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        format_date "$IT_DATE[i]"; stamp=$REPLY
        format_bytes $IT_SIZE[i]; printf -v sz '%6s' $REPLY
        input+=("${IT_BASE[i]}"$'\x1f'$stamp$sz$'\x1f'${IT_PATH[i]})
    done

    local choice
    # NB: print, not print -l by accident -- `print -r a b` joins its arguments
    # with a space, which would hand fzf a single line containing every item.
    choice=$(print -rl -- "${input[@]}" | fzf --reverse --prompt='Select item: ' \
        --delimiter=$'\x1f' --with-nth=2.. --print0 2>/dev/null) || return 0
    [[ -z $choice ]] && return 0

    local base=${choice%%$'\x1f'*}
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        if [[ $IT_BASE[i] == $base ]]; then
            print -r -- "${CYAN}Selected:${RESET} ${BOLD}${IT_PATH[i]:t}${RESET}"
            print -rn -- "${BOLD}${GREEN}(R)estore${RESET} or ${BOLD}${RED}(D)elete${RESET}? [${GREEN}r${RESET}/${RED}D${RESET}/${DIM}q${RESET}]: "
            local answer
            read -r answer
            case $answer in
                [Rr]) restore_one $i ;;
                [Dd]) delete_one $i ;;
                *)    return 0 ;;
            esac
            return
        fi
    done
    warn "could not locate the selected item."
    return 1
}

# Glob match for the find/restore subcommands. EXTENDED_GLOB is suspended so
# that (, | and ^ in a search term are ordinary characters, not operators.
glob_match() {
    # $1 basename, $2 user pattern, $3 full path. The pattern may match anywhere
    # in the name, so `*.bak` and `bak` both work.
    emulate -L zsh
    setopt LOCAL_OPTIONS NO_EXTENDED_GLOB
    # zsh reads a bare `|` as pattern alternation even without extended glob,
    # which would break patterns for filenames such as `we|ird.txt`. Escape it
    # so it is matched literally; everything else stays a normal glob.
    local pat=${2//|/\\|}
    # A malformed glob (say an unbalanced `[`) makes zsh print "bad pattern" and
    # abort the match; swallow it and report a plain non-match instead.
    { [[ $1 == *${~pat}* || $3 == *${~pat}* ]] } 2>/dev/null
}

find_trash() {
    local pattern=$1
    [[ -z $pattern ]] && die_usage "ztrash find requires a pattern"
    load_items

    local -i w
    w=$(term_width)
    local -i pathcol=$(( w - 21 ))
    (( pathcol < 12 )) && pathcol=12

    local -i found=0 i
    local -a hits
    hits=()
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        if glob_match "${IT_PATH[i]:t}" "$pattern" "$IT_PATH[i]"; then
            hits+=($i)
            (( found++ ))
        fi
    done

    if (( ! found )); then
        print -r -- "  ${YELLOW}No items match '$pattern'.${RESET}"
        return 1
    fi

    local -i wl=$(( w - 2 ))
    local rule
    rule=$(hr $wl)
    print -r -- "  ${BOLD}${CYAN}Matching${RESET} '${YELLOW}$pattern${RESET}'"
    print -r -- $rule
    printf "  ${CYAN}%-17s  ${BLUE}%s${RESET}\n" "Binned" "Path"
    print -r -- $rule
    for i in $hits; do
        format_date "$IT_DATE[i]"; local stamp=$REPLY
        truncate_path "$IT_PATH[i]" $pathcol; local shown=$REPLY
        printf "  ${CYAN}%-17s  ${BLUE}%s${RESET}\n" "$stamp" "$shown"
    done
    print -r -- $rule
    print -r -- "  ${CYAN}$found${RESET}${DIM} item(s) found${RESET}"
    return 0
}

restore_pattern() {
    local pattern=$1
    [[ -z $pattern ]] && die_usage "ztrash restore requires a pattern"
    load_items

    local -a hits
    hits=()
    local -i i rc=0
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        if glob_match "${IT_PATH[i]:t}" "$pattern" "$IT_PATH[i]"; then
            hits+=($i)
        fi
    done
    if (( ! ${#hits} )); then
        print -r -- "  ${YELLOW}No items matched '$pattern'.${RESET}"
        return 1
    fi
    local -i restored=0
    for i in $hits; do
        restore_one $i || rc=1
        (( restored++ ))
    done
    print -r -- "  ${GREEN}Restored ${CYAN}$restored${RESET}${GREEN} item(s).${RESET}"
    return $rc
}

# Remove trashinfo files with no payload and payloads with no trashinfo.
gc_trash() {
    load_items
    local -i i removed=0
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        if [[ $IT_GOOD[i] != 1 ]]; then
            if (( DRY_RUN )); then
                print -r -- "  ${YELLOW}would remove${RESET} stale metadata ${DIM}${IT_BIN[i]}/info/${IT_BASE[i]}.trashinfo${RESET}"
            else
                rm -f -- "$IT_BIN[i]/info/$IT_BASE[i].trashinfo"
                print -r -- "  ${GREEN}✓${RESET} removed stale metadata for ${DIM}${IT_PATH[i]}${RESET}"
            fi
            (( removed++ ))
        fi
    done

    # Payloads with no metadata at all.
    local -A tracked
    local tp
    for (( i = 1; i <= ${#IT_BASE}; i++ )); do
        tp=$IT_BIN[i]/files/$IT_BASE[i]
        tracked[$tp]=1
    done
    local -a orphans
    for p in "$TRASH_ROOT/files"/*(DN); do
        [[ -z ${tracked[$p]-} ]] && orphans+=($p)
    done
    local orphan
    for orphan in $orphans; do
        if (( DRY_RUN )); then
            print -r -- "  ${YELLOW}would remove${RESET} untracked ${DIM}${orphan}${RESET}"
        else
            rm -rf -- "$orphan"
            print -r -- "  ${GREEN}✓${RESET} removed untracked ${DIM}${orphan}${RESET}"
        fi
        (( removed++ ))
    done

    if (( ! removed )); then
        print -r -- "  ${GREEN}Trash is tidy.${RESET} Nothing to collect."
    else
        local noun="entries"
        (( removed == 1 )) && noun="entry"
        print -r -- "  ${CYAN}Collected ${BOLD}$removed${RESET} stale $noun${RESET}."
    fi
    return 0
}

watch_trash() {
    if [[ ! -t 1 ]]; then
        warn "-w needs an interactive terminal."
        return $EXIT_USAGE
    fi
    local prev=""
    while :; do
        load_items
        local -i total
        total=$(total_bytes)
        format_bytes $total
        local line="Trash: ${BOLD}${YELLOW}$REPLY${RESET} ${DIM}(${#IT_BASE} item(s))${RESET}"
        if [[ $line != $prev ]]; then
            print -r -- $'\e[H\e[2J'"${BOLD}${CYAN}Trash watcher${RESET} ${DIM}(Ctrl+C to stop)${RESET}"
            print -r -- ""
            print -r -- "  $line"
            print -r -- ""
            prev=$line
        fi
        sleep $WATCH_INTERVAL
    done
}

