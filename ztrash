    ops="-l --list -r --restore -d --delete -e --empty -s --size -u --undo"
    ops+=" -w --watch -p --purge --fzf --gc -y --yes -n --dry-run"
    ops+=" -v --verbose --json --version -h --help"
    case "$prev" in
