    # standard completion idiom. `read -a` would split on spaces instead and
    # mangle any candidate path containing one.
    # shellcheck disable=SC2207
    if [[ ${cur} == -* ]]; then
        COMPREPLY=( $(compgen -W "${ops}" -- "${cur}") )
    else
        COMPREPLY=( $(compgen -W "${ops} restore find" -- "${cur}") )
    fi
